{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Janela principal; arquivos acessíveis apenas após seleção nos diálogos nativos.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
